{
  "name": "dsh-work-components",
  "version": "0.4.3",
  "description": "DSH 工作组件插件：在「工作组件」设置页统一挂载并管理控制其他工作软件的 MCP 服务器（Office / Blender / Unity / Figma / Photoshop / Chrome / Godot / Windows / 桌面控制 / Notion / Gmail / Cloudflare / GitHub / ComfyUI / FFmpeg / Obsidian / REA 逆向分析），另含按游戏分卡的 GameBot（Minecraft / 文明 VI / 视觉）、会话控制、「通道」分组的 Telegram 和多模态工具 mm_send_image。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "mcp",
    "mcp-client",
    "work-components",
    "gamebot"
  ],
  "homepage": "https://github.com/meya-ashuripehya/dsh-work-components#readme",
  "bugs": {
    "url": "https://github.com/meya-ashuripehya/dsh-work-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meya-ashuripehya/dsh-work-components.git"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./sdk": "./lib/component-sdk.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/local-loader-worker.mjs",
    "lib/component-sdk.mjs",
    "lib/channel-telegram.mjs",
    "lib/gmail-server.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/**",
    "office/launch.py",
    "src/components/gamebot/pyproject.toml",
    "src/components/gamebot/README.md",
    "src/components/gamebot/MANIFEST.in",
    "src/components/gamebot/src/gamebot/**/*.py",
    "src/components/gamebot/minecraft-neoforge-bridge/**",
    "!src/components/gamebot/minecraft-neoforge-bridge/build/**",
    "!src/components/gamebot/minecraft-neoforge-bridge/.gradle/**",
    "!src/components/gamebot/minecraft-neoforge-bridge/src/test/**",
    "src/components/gamebot/protocol/minaret/**",
    "src/components/gamebot/docs/*.md",
    "src/components/gamebot/src/gamebot/adapters/civilization/*.mjs",
    "src/components/gamebot/src/gamebot/adapters/civilization/mod/TRIXCompanion/**",
    "src/components/desktop/**",
    "!src/components/desktop/**/bin/**",
    "!src/components/desktop/**/obj/**",
    "!src/components/desktop/**/*.old*",
    "!src/components/desktop/**/dist-build/**",
    "!src/components/desktop/**/*.pdb",
    "!src/components/desktop/broker/tests/**",
    "!**/.env",
    "!**/.env.*",
    "!**/*.pem",
    "!**/*.key",
    "!**/*.p12",
    "!**/*.pfx",
    "!**/.ssh/**",
    "!**/*.log",
    "!**/*.bak",
    "!**/*.bak-*",
    "!**/__pycache__/**",
    "!src/components/gamebot/minecraft-neoforge-bridge/run/**",
    "LICENSE",
    "NOTICE",
    "vendor/dsh-tools/LICENSE",
    "vendor/wsz987/*/LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run build && npm run check",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:office": "node scripts/office-smoke.mjs",
    "smoke:tools": "node scripts/tools-smoke.mjs",
    "smoke:connect": "node scripts/connect-smoke.mjs",
    "smoke:local": "node scripts/localcomp-smoke.mjs",
    "smoke:gamebot": "node scripts/smoke-gamebot.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "vendor:channels": "node scripts/vendor-channels.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@wsz987/channel-control": "0.5.1",
    "@wsz987/channel-core": "0.5.1",
    "@wsz987/channel-harness": "0.5.1",
    "@wsz987/channel-telegram": "0.5.1",
    "esbuild": "^0.25.0",
    "schemastery": "^3.18.0",
    "undici": "7.30.0"
  },
  "license": "MIT",
  "dependencies": {
    "image-size": "^2.0.4",
    "lunar-javascript": "^1.7.7"
  }
}
