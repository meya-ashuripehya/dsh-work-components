{
  "name": "dsh-work-components",
  "version": "0.3.0",
  "description": "DSH 工作组件插件：在「工作组件」设置页统一挂载并管理控制其他工作软件的 MCP 服务器（Office / Blender / Unity / Figma / Photoshop / Chrome / Godot / Windows / Notion / Cloudflare / GitHub / ComfyUI / FFmpeg / Obsidian），另含按游戏分卡的 GameBot（Minecraft / 文明 VI / 视觉兜底）、会话控制和多模态工具 mm_send_image。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "mcp",
    "mcp-client",
    "work-components",
    "gamebot"
  ],
  "homepage": "https://github.com/meya-ashuripehya/dsh-work-components#readme",
  "bugs": {
    "url": "https://github.com/meya-ashuripehya/dsh-work-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meya-ashuripehya/dsh-work-components.git"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./sdk": "./lib/component-sdk.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/local-loader-worker.mjs",
    "lib/component-sdk.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "office/launch.py",
    "src/components/gamebot/pyproject.toml",
    "src/components/gamebot/README.md",
    "src/components/gamebot/MANIFEST.in",
    "src/components/gamebot/src/gamebot/**/*.py",
    "src/components/gamebot/src/gamebot/adapters/civilization/*.mjs",
    "src/components/gamebot/src/gamebot/adapters/civilization/mod/TRIXCompanion/**",
    "LICENSE",
    "NOTICE",
    "vendor/dsh-tools/LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build && npm run check",
    "smoke": "node scripts/smoke.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "smoke:office": "node scripts/office-smoke.mjs",
    "smoke:tools": "node scripts/tools-smoke.mjs",
    "smoke:connect": "node scripts/connect-smoke.mjs",
    "smoke:local": "node scripts/localcomp-smoke.mjs",
    "smoke:gamebot": "node scripts/smoke-gamebot.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "schemastery": "^3.18.0"
  },
  "license": "MIT"
}
